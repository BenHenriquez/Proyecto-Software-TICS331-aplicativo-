# Copia este archivo como .env y ajusta los valores.
# Puerto del backend (el front de Vite hace proxy de /api hacia aquí).
PORT=3001
# Ruta de la base SQLite, relativa a la raíz del repositorio.
DB_PATH=backend/data/farmacia.db
# Token SIMULADO del backoffice: cualquier texto sirve. No es seguridad real.
BACKOFFICE_TOKEN=cambia-este-texto
# US-17 Ingreso con Neuro-Access. "simulado" (por defecto) no necesita red ni app;
# "neuron" usa el Quick Login real de TAG y necesita URL_PUBLICA_API (ver README).
IDENTIDAD_PROVEEDOR=simulado
NEURON_DOMINIO=lab.tagroot.io
# URL HTTPS pública que llega al backend (por ejemplo, la que entrega cloudflared). Sin barra final.
URL_PUBLICA_API=
