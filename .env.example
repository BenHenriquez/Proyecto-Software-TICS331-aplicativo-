# Copia este archivo como .env y ajusta los valores.
# Puerto del backend (el front de Vite hace proxy de /api hacia aquí).
PORT=3001
# Ruta de la base SQLite, relativa a la raíz del repositorio.
DB_PATH=backend/data/farmacia.db
# Token SIMULADO del backoffice: cualquier texto sirve. No es seguridad real.
BACKOFFICE_TOKEN=cambia-este-texto
